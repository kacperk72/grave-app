// API rodzinnej mapy GraveMap. Wdrożenie: `npm run deploy` (lokalnie, po
// `wrangler login`) albo automatycznie z CI po pushu na main.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grave-app-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "observability": { "enabled": true },
  // Adres *.workers.dev wystarczy — front łączy się z API przez CORS
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGINS": "https://znajdzgroby.pl,https://www.znajdzgroby.pl,https://darkgrey-octopus-623910.hostingersite.com",
    // Klucz z linku zaproszenia działa też jako klucz członka — dla wersji aplikacji
    // sprzed list członków. Wyłączyć ("false"), gdy wszyscy mają wpis w `members`.
    "ALLOW_INVITE_AS_MEMBER": "true",
    // Adres aplikacji w linkach z maili (lokalnie nadpisywany w `npm run dev`)
    "APP_URL": "https://znajdzgroby.pl",
    // Wysyłka maili: "resend" (produkcja, sekret RESEND_API_KEY) albo "log" (tylko lokalnie)
    "MAIL_MODE": "resend"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grave-app",
      "database_id": "b97eb1dc-2a89-43dd-a029-8fc03b735dd7",
      "migrations_dir": "migrations"
    }
  ],
  // Zdjęcia grobów (bajty) w Workers KV — darmowy plan bez karty, z twardymi limitami
  // (1 GB, 1000 zapisów/dzień), więc nie da się wygenerować rachunku.
  // Raz na dobę: usuwanie z KV zdjęć skasowanych map (src/purge.ts)
  "triggers": { "crons": ["17 3 * * *"] },
  "kv_namespaces": [
    {
      "binding": "PHOTOS",
      "id": "f07e01ca2fac486ab366083c2f8f5717"
    }
  ]
  // Lokalnie (`npm run dev`) ALLOWED_ORIGINS nadpisuje flaga --var w package.json
}
