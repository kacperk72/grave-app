# Konfiguracja Apache na Hostingerze — trafia do public_html razem z buildem.

# Aplikacja jednostronicowa (Angular): adres bez pliku na dysku (np. /graves/123)
# serwujemy jako index.html, a trasę rozwiązuje już router w przeglądarce.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Po tych plikach service worker (PWA) rozpoznaje nową wersję — nie mogą
  # utknąć w cache przeglądarki ani serwera, inaczej wydanie nigdy nie dotrze.
  <FilesMatch "^(index\.html|ngsw\.json|ngsw-worker\.js|safety-worker\.js|worker-basic\.min\.js|version\.json|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Skrypty i style z hashem w nazwie (np. main-AB12CD34.js) nigdy się nie zmieniają —
  # nowa wersja dostaje nową nazwę, więc można je trzymać w cache bardzo długo.
  <FilesMatch "-[A-Z0-9]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
